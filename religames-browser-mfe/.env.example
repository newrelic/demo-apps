# --- New Relic Browser (SPA-capable, "container") agent ---
# Leave these blank to run the app without any New Relic reporting -- it
# still works, still generates load, and is fully clickable. Fill them in
# from your NR account's Browser app "Copy/Paste JS code" (one.newrelic.com >
# Browser > add a SPA-capable Browser app > Application settings) when you're
# ready to wire up NR instrumentation. See README.md > "Wiring up New Relic".
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_TRUST_KEY=
NEW_RELIC_AGENT_ID=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APPLICATION_ID=

# --- App ports ---
SHELL_PORT=8098

# --- Load generator ---
# LOADGEN_USERS is capped at 5 (the size of the fixed player-identity pool in loadgen/users.js)
LOADGEN_USERS=3
LOADGEN_INTERVAL_MS=15000
