# Copy to .env and fill in values. Never commit .env.
# Add your New Relic ingest license key below for reporting.
NEW_RELIC_LICENSE_KEY=

# Set to true once a license key is provided, to send data to New Relic.
NEW_RELIC_MONITOR_MODE=false
NEW_RELIC_APP_NAME=ReliState-Demo
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG=stdout
NEW_RELIC_LOG_LEVEL=info
ENVIRONMENT=development
SERVICE_TIER=tier-1
OWNER_TEAM=platform

# Demo-only shared secret for the mock agent-token endpoint. Not a real credential.
DEMO_API_SECRET=local-demo-secret
